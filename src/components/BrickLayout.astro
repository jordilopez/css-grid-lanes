---
import { fetchDogImages } from '../lib/dogs';

interface Props {
  count?: number;
}

const { count = 9 } = Astro.props;
const images = await fetchDogImages(count);
---
<div class="lanes lanes--brick">
  {images.map((url, i) => (
    <figure class="card">
      {url.startsWith('placeholder:') ? <div class="card--placeholder">🐾</div> : <img src={url} alt={`Dog ${i + 1}`} loading="lazy" />}
      <figcaption class="card__caption">#{i + 1}</figcaption>
    </figure>
  ))}
</div>

<style>
  /* Brick layout: lanes defined with grid-template-rows instead of
     grid-template-columns — the flow runs left-to-right. */
  .lanes--brick {
    display: grid-lanes;
    grid-template-rows: 1fr 1fr 1fr;
    gap: 1rem;
  }
  .card--placeholder {
    min-height: 10rem;
  }
</style>
