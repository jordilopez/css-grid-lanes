---
import { fetchDogImages } from '../lib/dogs';

interface Props {
  count?: number;
}

const { count = 10 } = Astro.props;
const images = await fetchDogImages(count);
const teasers = images.slice(1);
---
<div class="lanes lanes--spanning">
  <article class="card card--hero">
    {images[0].startsWith('placeholder:') ? <div class="card--placeholder">🐾 hero story</div> : <img src={images[0]} alt="Featured dog story" />}
    <figcaption class="card__caption"><strong>Lead story</strong> — spans four lanes on wide screens</figcaption>
  </article>
  {teasers.map((url, i) => (
    <article class:list={['card', { 'card--wide': i < 7 }]}>
      {url.startsWith('placeholder:') ? <div class="card--placeholder">🐾</div> : <img src={url} alt={`Dog story ${i + 2}`} loading="lazy" />}
      <figcaption class="card__caption">Teaser #{i + 2}</figcaption>
    </article>
  ))}
</div>

<style>
  /* Newspaper layout: items span multiple lanes. */
  .lanes--spanning {
    display: grid-lanes;
    grid-template-columns: repeat(auto-fill, minmax(20ch, 1fr));
    gap: 2lh;
  }
  .lanes--spanning .card {
    grid-column: span 1;
  }
  .lanes--spanning .card--wide {
    grid-column: span 2;
  }
  .lanes--spanning .card--hero {
    grid-column: span 4;
  }
  .card--placeholder {
    min-height: 8rem;
  }
  @media (width > 1250px) {
    .lanes--spanning .card--hero {
      grid-column: span 4;
    }
  }
</style>
