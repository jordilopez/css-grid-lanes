---
import { fetchDogImages } from '../lib/dogs';

interface Props {
  count?: number;
}

const { count = 12 } = Astro.props;
const images = await fetchDogImages(count);
---
<div class="lanes lanes--placed">
  <header class="placed-header">
    <h3>Header pinned to the last lanes</h3>
    <p>Explicitly placed with <code>grid-column: -3 / -1</code> — no matter how many lanes exist.</p>
  </header>
  {images.map((url, i) => (
    <figure class="card">
      {url.startsWith('placeholder:') ? <div class="card--placeholder">🐾</div> : <img src={url} alt={`Dog ${i + 1}`} loading="lazy" />}
      <figcaption class="card__caption">#{i + 1}</figcaption>
    </figure>
  ))}
</div>

<style>
  /* Explicit placement: header always in the last two lanes. */
  .lanes--placed {
    display: grid-lanes;
    grid-template-columns: repeat(auto-fill, minmax(24ch, 1fr));
    gap: 1rem;
  }
  .placed-header {
    grid-column: -3 / -1;
    background: var(--c-primary);
    color: var(--c-text-inverse);
    border-radius: var(--br-md, 8px);
    padding: var(--sp-4, 1.5rem);
  }
  .placed-header p { margin: 0; font-size: var(--fs-sm); }
  .placed-header h3 { margin-top: 0; }
</style>
