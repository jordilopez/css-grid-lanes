---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchDogImages } from '../lib/dogs';

const images = await fetchDogImages(6);
---
<BaseLayout title="CSS Grid Lanes Demo">
  <section>
    <h2 class="example__title">Scaffold</h2>
    <p>{images.length} dog images fetched for the upcoming examples.</p>
  </section>
</BaseLayout>
